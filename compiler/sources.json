{
  "rulesets": [
    {
      "id": "ads",
      "name": "Ads",
      "description": "EasyList: the standard ad-blocking list",
      "enabledByDefault": true,
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/easylist/easylist/gh-pages/easylist.txt",
          "license": "GPL-3.0 / CC BY-SA 3.0"
        }
      ]
    },
    {
      "id": "ublock",
      "name": "Ads (uBlock fixes)",
      "description": "uBlock filters: anti-adblock defusers and fixes for sites EasyList misses",
      "enabledByDefault": true,
      "targets": [
        "chrome",
        "dns"
      ],
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/filters.txt",
          "license": "GPL-3.0"
        }
      ]
    },
    {
      "id": "privacy",
      "name": "Trackers",
      "description": "EasyPrivacy: analytics, beacons and fingerprinting scripts",
      "enabledByDefault": true,
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/easylist/easylist/gh-pages/easyprivacy.txt",
          "license": "GPL-3.0 / CC BY-SA 3.0"
        }
      ]
    },
    {
      "id": "cname",
      "name": "Cloaked trackers",
      "description": "First-party subdomains that secretly alias trackers (CNAME cloaking)",
      "enabledByDefault": true,
      "targets": [
        "chrome"
      ],
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_trackers_justdomains.txt",
          "license": "MIT",
          "format": "hosts"
        }
      ]
    },
    {
      "id": "hosts",
      "name": "Ad & malware hosts",
      "description": "StevenBlack unified hosts: ad servers and malware domains",
      "enabledByDefault": true,
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts",
          "license": "MIT"
        }
      ]
    }
  ],
  "cnameTargets": {
    "url": "https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_original_trackers.txt",
    "license": "MIT",
    "note": "Trackers that hide behind CNAME aliases. Used ONLY to judge CNAME targets on Android, never as direct blocks (it includes vendors' own sites)."
  }
}
