{
  "rulesets": [
    {
      "id": "ads",
      "name": "Ads",
      "description": "EasyList: the standard ad-blocking list",
      "enabledByDefault": true,
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/easylist/easylist/gh-pages/easylist.txt",
          "license": "GPL-3.0 / CC BY-SA 3.0"
        }
      ]
    },
    {
      "id": "ublock",
      "name": "Ads (uBlock fixes)",
      "description": "uBlock filters: anti-adblock defusers, fixes for sites EasyList misses, and uBlock's own breakage fixes",
      "enabledByDefault": true,
      "targets": [
        "chrome",
        "dns"
      ],
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/filters.txt",
          "license": "GPL-3.0"
        },
        {
          "url": "https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/unbreak.txt",
          "license": "GPL-3.0"
        },
        {
          "url": "https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/quick-fixes.txt",
          "license": "GPL-3.0"
        },
        {
          "file": "data/nullroute-unbreak.txt",
          "license": "GPL-3.0"
        }
      ]
    },
    {
      "id": "privacy",
      "name": "Trackers",
      "description": "EasyPrivacy: analytics, beacons and fingerprinting scripts",
      "enabledByDefault": true,
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/easylist/easylist/gh-pages/easyprivacy.txt",
          "license": "GPL-3.0 / CC BY-SA 3.0"
        }
      ]
    },
    {
      "id": "cname",
      "name": "Cloaked trackers",
      "description": "First-party subdomains that secretly alias trackers (CNAME cloaking)",
      "enabledByDefault": true,
      "targets": [
        "chrome"
      ],
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_trackers_justdomains.txt",
          "license": "MIT",
          "format": "hosts"
        }
      ]
    },
    {
      "id": "hosts",
      "name": "Ad & malware hosts",
      "description": "StevenBlack unified hosts: ad servers and malware domains",
      "enabledByDefault": true,
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts",
          "license": "MIT"
        }
      ]
    }
  ],
  "cnameTargets": {
    "url": "https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_original_trackers.txt",
    "license": "MIT",
    "note": "Trackers that hide behind CNAME aliases. Used ONLY to judge CNAME targets on Android, never as direct blocks (it includes vendors' own sites)."
  },
  "reputation": {
    "note": "Phishing, malware and scam domains. Too big to ship as a blocklist: compiled into a local hash-prefix set plus server-side shards (see nullroute_compiler/reputation.py).",
    "sources": [
      {
        "url": "https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/tif-onlydomains.txt",
        "license": "GPL-3.0",
        "name": "HaGeZi Threat Intelligence Feeds"
      },
      {
        "url": "https://raw.githubusercontent.com/mitchellkrogza/Phishing.Database/master/phishing-domains-ACTIVE.txt",
        "license": "MIT",
        "name": "Phishing.Database (active)"
      }
    ],
    "popular": {
      "url": "https://raw.githubusercontent.com/zer0h/top-1000000-domains/master/top-10000-domains",
      "note": "Exact matches are never listed: a feed has no business blocking a top-10k site outright."
    }
  }
}
