{
  "manifest_version": 3,
  "name": "NullRoute",
  "short_name": "NullRoute",
  "version": "1.0.0",
  "description": "Fast, private ad & tracker blocker. Blocks network requests with Chrome's declarativeNetRequest engine — no page data ever leaves your browser.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "webNavigation",
    "storage",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "NullRoute",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {"id": "ads", "enabled": true, "path": "rulesets/rules_ads.json"},
      {"id": "privacy", "enabled": true, "path": "rulesets/rules_privacy.json"},
      {"id": "hosts", "enabled": true, "path": "rulesets/rules_hosts.json"}
    ]
  },
  "web_accessible_resources": []
}
