<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#1B2333</color>
    <color name="paper">#EEF1F6</color>
    <color name="route">#2F5BEA</color>

    <!-- Compose draws the UI; this only sets the launch window background. -->
    <style name="Theme.NullRoute" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
